{
  "info": {
    "_postman_id": "b3e94a81-d7f1-4c91-a1b2-msu-cloud-001",
    "name": "Mesa de Servicios Universitarios - Suite de API Despliegue Nube (OCI)",
    "description": "Suite de verificación de API automatizada ejecutada contra el entorno en la nube desplegado en Oracle Cloud Infrastructure (https://msu-157-137-206-147.sslip.io). Valida CSRF, registro dinámico, autenticación, perfil, catálogos, creación y consulta de solicitudes y logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var sc = pm.response.headers.all().filter(function(h) { return h.key.toLowerCase() === 'set-cookie'; });",
          "for (var i = 0; i < sc.length; i++) {",
          "    var m = sc[i].value.match(/XSRF-TOKEN=([^;]+)/);",
          "    if (m) {",
          "        pm.environment.set('csrf_token', m[1]);",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var method = pm.request.method;",
          "var csrf = pm.environment.get('csrf_token');",
          "if (['POST', 'PUT', 'DELETE', 'PATCH'].includes(method)) {",
          "    if (csrf) {",
          "        pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: csrf });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Handshake CSRF y Cabeceras de Seguridad",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function() { pm.response.to.have.status(200); });",
              "pm.test('Cabecera X-Correlation-Id presente', function() { pm.expect(pm.response.headers.has('X-Correlation-Id')).to.be.true; });",
              "pm.test('Token CSRF detectado', function() {",
              "    pm.expect(pm.environment.get('csrf_token')).to.not.be.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/csrf",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "csrf"]
        }
      }
    },
    {
      "name": "02 - Registro exitoso de nuevo Solicitante en la nube",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ts = Date.now();",
              "var correo = 'alex.cloud.' + ts + '@unmsm.edu.pe';",
              "pm.environment.set('usuario_correo', correo);",
              "pm.environment.set('usuario_password', 'Password123!');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201 Created', function() { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('Usuario registrado con rol SOLICITANTE', function() {",
              "    pm.expect(json.rol).to.eql('SOLICITANTE');",
              "    pm.expect(json.correo).to.eql(pm.environment.get('usuario_correo'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Alex SDET Nube QA\",\n    \"correo\": \"{{usuario_correo}}\",\n    \"password\": \"{{usuario_password}}\",\n    \"vinculo\": \"ESTUDIANTE\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/registro",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "registro"]
        }
      }
    },
    {
      "name": "03 - Validación 400 por correo inválido",
      "event": [
