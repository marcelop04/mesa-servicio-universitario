# Plantilla sin secretos. Para una base LOCAL NUEVA: scripts/preparar-entorno.ps1.
# Con una base existente, conservar sus credenciales: generar otras NO modifica MySQL.
# Nube: despliegue/.env.example y generador del manual técnico.
SPRING_PROFILES_ACTIVE=dev
DB_USER=msu
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Clave aleatoria de al menos 32 bytes. No reutilizar la de pruebas.
JWT_SECRET=
DATOS_DEMO=true
DATOS_DEMO_SOLICITUDES=true
DEMO_PASSWORD=
# HTTP local: false. HTTPS desplegado: true y SEGURIDAD_DESPLIEGUE=true, DATOS_DEMO=false.
COOKIE_SECURE=false
SEGURIDAD_DESPLIEGUE=false
LOGIN_MAX_FALLOS=5
LOGIN_MAX_FALLOS_IP=50
LOGIN_VENTANA=PT15M
# Vacío hasta acordar con David los proxies que sobrescriben X-Real-IP.
LOGIN_PROXIES_CONFIABLES=
