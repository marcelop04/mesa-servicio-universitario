# Referencia de las variables de la nube. NO usar estas claves de ejemplo.
# Crear valores aleatorios con scripts/crear-entorno.py y guardar el archivo
# completo en GitHub Secret PRODUCTION_ENV, nunca en Git.
COMPOSE_PROJECT_NAME=msu-prod
SPRING_PROFILES_ACTIVE=prod
APP_HOST=msu-203-0-113-10.sslip.io
ACME_EMAIL=tu-correo@example.org
DB_USER=msu
DB_PASSWORD=GENERAR_CON_EL_SCRIPT
MYSQL_ROOT_PASSWORD=GENERAR_CON_EL_SCRIPT
JWT_SECRET=GENERAR_CON_EL_SCRIPT_MINIMO_32_BYTES
DATOS_DEMO=false
DATOS_DEMO_SOLICITUDES=false
DEMO_PASSWORD=GENERAR_CON_EL_SCRIPT
TAREAS_HABILITADAS=true
# C1: prod activa el guard de despliegue. No habilitar demo para saltarlo.
LOGIN_MAX_FALLOS=5
LOGIN_MAX_FALLOS_IP=50
LOGIN_VENTANA=PT15M
# Configurar solo proxies verificados; nunca 0.0.0.0/0 ni ::/0.
LOGIN_PROXIES_CONFIABLES=
