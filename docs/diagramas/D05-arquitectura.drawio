      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c4" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Plataforma de despliegue · Docker (contenedores separados)&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.3;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=7 5;rounded=0;" vertex="1" parent="1"><mxGeometry x="420" y="74" width="880" height="938" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;Navegador web&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;(solicitante, técnico, supervisor,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;administrador)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#efefef;strokeWidth=1.4;align=center;verticalAlign=top;spacing=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="240" height="300" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Contenedor backend · API Spring Boot (monolito modular)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#fafafa;strokeWidth=1.6;align=left;verticalAlign=top;spacing=10;rounded=0;" vertex="1" parent="1"><mxGeometry x="450" y="228" width="830" height="574" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Módulos por épica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;i&gt;(cada módulo atraviesa las cinco capas)&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=top;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="830" y="426" width="430" height="222" as="geometry"/></mxCell><mxCell id="c38" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Red privada (sin acceso público)&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=right;verticalAlign=top;spacing=8;dashed=1;dashPattern=7 5;rounded=0;" vertex="1" parent="1"><mxGeometry x="450" y="852" width="830" height="144" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Aplicación React (SPA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Vistas y menú por rol&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Formularios con validación&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Estado y componentes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;   compartidos&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Rutas protegidas&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Cliente de API (fetch)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Responsive 360 / 1366 px&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=left;verticalAlign=top;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="48" y="335" width="204" height="195" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Contenedor frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;servidor web estático con la&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;build de React (HTML, JS, CSS)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="450" y="112" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Spring Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;JWT de duración limitada en cookie HttpOnly (Secure) · protección C