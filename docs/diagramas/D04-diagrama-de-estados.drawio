 del informe&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="24.0" y="15.0" width="382.8" height="48.2" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Crear&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Solicitante /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;campos válidos]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="67.4" y="145.1" width="105.2" height="55.9" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Evaluar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Supervisor]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="489.3" y="161.7" width="81.4" height="39.3" as="geometry"/></mxCell><mxCell id="c20" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Asignar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Supervisor /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;técnico activo del área]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="736.0" y="272.0" width="145.0" height="55.9" as="geometry"/></mxCell><mxCell id="c22" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Iniciar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Técnico asignado /&lt;/font&gt;&lt;br&gt;&lt;