;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="1014.0" y="247.1" width="116.8" height="105.8" as="geometry"/></mxCell><mxCell id="c30" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Confirmar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Solicitante /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;antes de 72 h]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="196.6" y="727.0" width="94.4" height="55.9" as="geometry"/></mxCell><mxCell id="c32" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Cierre automático&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Sistema, proceso periódico /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;al cumplirse 72 h sin respuesta]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="369.0" y="727.0" width="194.9" height="55.9" as="geometry"/></mxCell><mxCell id="c34" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Cancelar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;[Supervisor con motivo /&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;desde cualquier pendiente;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;duplicado con referencia]&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;spacing=2;" vertex="1" parent="1"><mxGeometry x="784.0" y="465.7" width="168.2" height="72.6" as="geometry"/></mxCell></root>
