      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c4" value="&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;Pendiente&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&lt;i&gt;(Registrada, En evaluación, Asignada o En atención)&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#f6f6f6;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="760" height="360" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Registrada&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="250" y="175" width="160" height="58" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;En evaluación&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="650" y="175" width="160" height="58" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Asignada&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="650" y="365" width="160" height="58" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;En atención&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="250" y="365" width="160" height="58" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Resuelta&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="250" y="600" width="160" height="58" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Cerrada&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;shape=ext;double=1;" vertex="1" parent="1"><mxGeometry x="250" y="850" width="160" height="58" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Cancelada&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;shape=ext;double=1;" vertex="1" parent="1"><mxGeometry x="700" y="545" width="160" height="58" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;aspect=fixed;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="28" y="190" width="26" height="26" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;shape=doubleEllipse;aspect=fixed;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="864" width="30" height="30" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;shape=doubleEllipse;aspect=fixed;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="559" width="30" height="30" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Cerrada y Cancelada son estados finales: no admiten edición operativa.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Cada transición es una operación propia del backend; no hay cambio libre&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;   de estado. Reasignar conserva Asignada o En atención y no reinicia fechas.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Cambiar de área sin categoría y técnico válidos vuelve a En evaluación.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• La ventana de conformidad dura 72 h desde la última resolución; fuera&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;   de ella el backend rechaza la reapertura (RN08).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Línea discontinua: transición automática del sistema.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=left;verticalAlign=top;spacing=12;dashed=1;dashPattern=7 5;rounded=0;" vertex="1" parent="1"><mxGeometry x="580" y="740" width="570" height="160" as="geometry"/></mxCell><mxCell id="c15" value="" style="html=1;rounded=0;endSize=10;strokeColor=#000;strokeWidth=1.4;jumpStyle=arc;jumpSize=12;endArrow=block;endFill=1;startArrow=none;exitX=1.0000;exi