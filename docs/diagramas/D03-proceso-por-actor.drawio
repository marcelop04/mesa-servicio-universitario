  <diagram id="d1" name="D03 Proceso por actor">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1880" math="0" shadow="0" background="#ffffff">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c4" value="Solicitante" style="swimlane;html=1;startSize=46;horizontal=1;fontStyle=1;fontSize=17;fillColor=#e3e3e3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="72" width="290" height="1640" as="geometry"/></mxCell><mxCell id="c5" value="Sistema" style="swimlane;html=1;startSize=46;horizontal=1;fontStyle=1;fontSize=17;fillColor=#e3e3e3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="310" y="72" width="290" height="1640" as="geometry"/></mxCell><mxCell id="c6" value="Supervisor" style="swimlane;html=1;startSize=46;horizontal=1;fontStyle=1;fontSize=17;fillColor=#e3e3e3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="600" y="72" width="290" height="1640" as="geometry"/></mxCell><mxCell id="c7" value="Técnico" style="swimlane;html=1;startSize=46;horizontal=1;fontStyle=1;fontSize=17;fillColor=#e3e3e3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=1.4;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="890" y="72" width="290" height="1640" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="148.0" y="133" width="34" height="34" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Registrar solicitud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;categoría, ubicación, problema,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;impacto y urgencia&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="58.0" y="204.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Generar código MSU,&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;prioridad inicial y plazos&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ Registrada&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="348.0" y="314.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Evaluar y priorizar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;corrige impacto o urgencia&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;con motivo si corresponde&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ En evaluación&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="638.0" y="418.0" width="214" height="88" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;shape=mxgraph.bpmn.gateway2;gwType=exclusive;outline=none;symbol=exclusiveGw;" vertex="1" parent="1"><mxGeometry x="715.0" y="550.0" width="60" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Asignar técnico activo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;del área según prioridad&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;y carga visible&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ Asignada&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="638.0" y="646.0" width="214" height="88" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Iniciar atención&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;registra la primera atención&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ En atención&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="928.0" y="764.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Registrar avances&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;comentarios y evidencias&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="928.0" y="880.0" width="214" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Resolver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;solución obligatoria&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ Resuelta&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="928.0" y="984.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Cancelar con motivo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;duplicado: código relacionado&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ Cancelada&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="638.0" y="874.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;aspect=fixed;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="728.0" y="988" width="34" height="34" as="geometry"/></mxCell><mxCell id="c22" value="&lt;font style=&quot;font-size:12px&quot;&gt;Excepción: el supervisor puede&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;cancelar en cualquier estado&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;pendiente (de Registrada a En atención).&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=left;verticalAlign=middle;spacing=8;dashed=1;dashPattern=7 5;rounded=0;" vertex="1" parent="1"><mxGeometry x="622" y="1040" width="232" height="62" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Notificar la solución&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;y abrir ventana de&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;conformidad de 72 h&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="348.0" y="1104.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;shape=mxgraph.bpmn.shape;outline=standard;symbol=timer;perimeter=ellipsePerimeter;aspect=fixed;outline=catching;" vertex="1" parent="1"><mxGeometry x="361" y="1162" width="28" height="28" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Revisar la solución&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;confirmar o reabrir&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;(motivo si reabre)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="58.0" y="1214.0" width="214" height="72" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;shape=mxgraph.bpmn.gateway2;gwType=exclusive;outline=none;symbol=exclusiveGw;" vertex="1" parent="1"><mxGeometry x="135.0" y="1335.0" width="60" height="60" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;shape=mxgraph.bpmn.gateway2;gwType=exclusive;outline=none;symbol=exclusiveGw;" vertex="1" parent="1"><mxGeometry x="425.0" y="1335.0" width="60" height="60" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Cerrar caso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;por confirmación o&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;automático a 72 h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;i&gt;→ Cerrada&lt;/i&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="348.0" y="1446.0" width="214" height="88" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Consolidar indicadores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;conteos, tiempos y cumplimiento&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=12;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="348.0" y="1570.0" width="214" height="60" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;aspect=fixed;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="438.0" y="1655" width="34" height="34" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Aspectos transversales (Sistema, en cada paso)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Historial: cada transición, comentario y reasignación queda como evento.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Permisos: el servidor comprueba rol y recurso en cada operación.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Avisos internos a los participantes ante cada cambio relevante.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;• Control de plazos: aviso al 80 %, escalamiento al vencer; revisión&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;   cada 5 minutos (primera atención y resolución).&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=left;verticalAlign=top;spacing=12;dashed=1;dashPattern=7 5;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="1728" width="760" height="140" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=left;verticalAlign=top;spacing=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="800" y="1728" width="380" height="140" as="geometry"/></mxCell><mxCell id="c63" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="818" y="1768" width="24" height="24" as="geometry"/></mxCell><mxCell id="c65" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;ellipse;aspect=fixed;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="998" y="1768" width="24" height="24" as="geometry"/></mxCell><mxCell id="c67" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;shape=mxgraph.bpmn.gateway2;gwType=exclusive;outline=none;symbol=exclusiveGw;" vertex="1" parent="1"><mxGeometry x="817" y="1803" width="26" height="26" as="geometry"/></mxCell><mxCell id="c69" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;strokeColor=#000000;fillColor=#ffffff;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=8;shape=mxgraph.bpmn.shape;outline=standard;symbol=timer;perimeter=ellipsePerimeter;aspect=fixed;outline=catching;" vertex="1" parent="1"><mxGeometry x="998" y="1804" width="24" height="24" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;rounded=0;endSize=10;strokeColor=#000;strokeWidth=1.4;jumpStyle=arc;jumpSize=12;endArrow=block;endF